    "disable": "NANO_PRODUCT_REPLACEMENT_UPDATE_CHECK=0",
    "recovery": "Offline/timeout retains installation and caches failure for 24h; concurrent checks use an exclusive lock; malformed user state is preserved.",
    "installation": "explicit-only",
    "channel": "latest"
