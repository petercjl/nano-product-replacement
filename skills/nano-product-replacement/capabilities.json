{
  "schema": "portable-skill-capabilities",
  "schema_version": "1.0.0",
  "skill": "nano-product-replacement",
  "target_platforms": [
    "generic"
  ],
  "capabilities": [
    {
      "id": "workspace.files",
      "purpose": "保留原件与任务记录",
      "required": true,
      "required_features": [
        "read",
        "exclusive-write"
      ],
      "input_fields": [
        "request"
      ],
      "output_fields": [
        "ok",
        "artifacts",
        "metadata",
        "task_id",
        "cost",
        "warnings"
      ],
      "side_effects": {
        "external_mutation": false,
        "may_cost_money": false,
        "authorization": "Local processing within requested workspace; generation only within explicit human generation authorization and host routing."
      },
      "errors": [
        "CAPABILITY_UNAVAILABLE",
        "FEATURE_UNSUPPORTED",
        "OUTPUT_CONTRACT_FAILED"
      ]
    },
    {
      "id": "image.inspect",
      "purpose": "实际查看场景、实物、涂黑底图和全部结果",
      "required": true,
      "required_features": [
        "local-images",
        "detail-inspection"
      ],
      "input_fields": [
        "request"
      ],
      "output_fields": [
        "ok",
        "artifacts",
        "metadata",
        "task_id",
        "cost",
        "warnings"
      ],
      "side_effects": {
        "external_mutation": false,
        "may_cost_money": false,
        "authorization": "Local processing within requested workspace; generation only within explicit human generation authorization and host routing."
      },
      "errors": [
        "CAPABILITY_UNAVAILABLE",
        "FEATURE_UNSUPPORTED",
        "OUTPUT_CONTRACT_FAILED"
      ]
    },
    {
      "id": "local.images",
      "purpose": "确定性遮挡与结果核验对比图",
      "required": true,
      "required_features": [
        "polygon-grow",
        "protect",
        "collect-hashes",
        "comparison-sheet",
        "coordinate-inspection",
        "simple-polygon-validation",
        "local-warm-pixel-protection"
      ],
      "input_fields": [
        "request"
      ],
      "output_fields": [
        "ok",
        "artifacts",
        "metadata",
        "task_id",
        "cost",
        "warnings"
      ],
      "side_effects": {
        "external_mutation": false,
        "may_cost_money": false,
        "authorization": "Local processing within requested workspace; generation only within explicit human generation authorization and host routing."
      },
      "errors": [
        "CAPABILITY_UNAVAILABLE",
        "FEATURE_UNSUPPORTED",
        "OUTPUT_CONTRACT_FAILED"
      ]
    },
    {
      "id": "media.generate",
      "purpose": "按人类与宿主选择的媒体能力执行生成",
      "required": true,
      "required_features": [
        "ordered-references",
        "task-recovery",
        "local-artifacts"
      ],
      "input_fields": [
        "request"
      ],
      "output_fields": [
        "ok",
        "artifacts",
        "metadata",
        "task_id",
        "cost",
        "warnings"
      ],
      "side_effects": {
        "external_mutation": true,
        "may_cost_money": true,
        "authorization": "Local processing within requested workspace; generation only within explicit human generation authorization and host routing."
      },
      "errors": [
        "CAPABILITY_UNAVAILABLE",
        "FEATURE_UNSUPPORTED",
        "OUTPUT_CONTRACT_FAILED"
      ]
    }
  ],
  "host_resolution": {
    "fallback_adapter": "generic",
    "destination": "Caller resolves exact target-directory for unnamed hosts."
  },
  "package_version": "0.2.2",
  "installationLifecycle": {
    "agentNeutral": true,
    "skillRequired": true,
    "updateRequiresSkillSync": true,
    "required_components": [
      "cli",
      "skill",
      "runtime"
    ],
    "installGuide": "INSTALL.md",
    "updateGuide": "UPDATE.md",
    "explicitTargetRequired": true,
    "hostDiscoveryVerification": true,
    "physicalCopies": true,
    "isolatedRuntime": true,
    "sharedLinks": false,
    "postBumpIdentityValidation": true,
    "install": "Resolve own directory; skill install --agent AGENT --path EXACT_SKILL_DIR --json",
    "update": "Resolve selected target first; update install --yes --path EXACT_SKILL_DIR --json",
    "verification": "Local runtime version, managed hashes, then host-native discovery",
    "target_scope": "selected current Agent only",
    "targetRequired": true,
    "hostRegistrationRequired": true,
    "installationMode": "copy",
    "sharedLinksAllowed": false,
    "isolatedRuntimeRequired": true
  },
  "automaticUpdates": {
    "enabledByDefault": true,
    "defaultMode": "notify",
    "intervalHours": 24,
    "timeoutMs": 2000,
    "trigger": "ordinary task entry; excludes help/version/source/task polling",
    "configuration": "update policy --mode off|notify|auto --yes --path EXACT_SKILL_DIR",
    "disable": "NANO_PRODUCT_REPLACEMENT_AUTO_UPDATE=0",
    "installation": "explicit standing authorization; compatible stable version only",
    "recovery": "update operation and resume reuse verified candidate"
  },
