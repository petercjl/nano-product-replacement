{
  "name": "@petercjl/nano-product-replacement",
  "version": "0.2.2",
  "description": "Reference-based product replacement workflow with portable local masking and managed Agent Skills.",
  "type": "module",
  "bin": {
    "nano-product-replacement": "bin/nano-product-replacement.mjs"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "capabilities.json",
    "README.md",
    "LICENSE",
    "skill-integrity.json",
    "lifecycle",
    "INSTALL.md",
    "UPDATE.md",
    "release-integrity.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petercjl/nano-product-replacement.git"
  },
  "homepage": "https://github.com/petercjl/nano-product-replacement#readme",
  "bugs": {
    "url": "https://github.com/petercjl/nano-product-replacement/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test --test-concurrency=2 test/*.test.mjs",
    "check": "node --check bin/nano-product-replacement.mjs && npm test",
    "validate:release": "node lifecycle/validate-release.mjs",
    "prepack": "node lifecycle/validate-release.mjs",
    "postinstall": "node lifecycle/notice.mjs",
    "version": "node lifecycle/version.mjs",
    "verify:packed": "node scripts/verify-packed.mjs",
    "verify:historical": "node scripts/verify-historical.mjs"
  },
  "dependencies": {
    "sharp": "0.35.5",
    "yaml": "2.9.1"
  },
  "skillLifecycle": {
    "skill": "nano-product-replacement",
    "entry": "bin/nano-product-replacement.mjs",
    "env": "NANO_PRODUCT_REPLACEMENT",
    "legacyMarker": ".nano-install.json",
    "contract": 2
  }
}
